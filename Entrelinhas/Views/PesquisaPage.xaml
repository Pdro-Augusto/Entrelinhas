<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Entrelinhas.Views.PesquisaPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             xmlns:droid="clr-namespace:CommunityToolkit.Maui.PlatformConfiguration.AndroidSpecific;assembly=CommunityToolkit.Maui"
             droid:NavigationBar.Color="{StaticResource BackgroundColor}"
             droid:NavigationBar.Style="DarkContent">

    <!--Grid da página inteira para  indicador de carregamento-->
    <Grid>

        <!-- Barra de pesquisa -->
        <Grid RowDefinitions="Auto, Auto, *">
            <Grid Grid.Row="0"
                  Padding="20, 20, 20, 0"
                  ColumnDefinitions="*, Auto"
                  ColumnSpacing="10">
                <Border StrokeShape="RoundRectangle 10"
                        Stroke="{StaticResource MainColor}"
                        Background="{StaticResource MainColorAlpha}"
                        Padding="10,0"
                        HeightRequest="45">
                    <Grid ColumnDefinitions="Auto, *">
                        <Entry Grid.Column="1"
                                 x:Name="searchBook"
                                 Placeholder="Procure por ISBN, Título, Autor..."
                                 PlaceholderColor="{StaticResource SubFontAlpha}"
                                 BackgroundColor="Transparent"
                                 TextColor="{StaticResource FontColor}"/>
                    </Grid>
                </Border>

                <Button x:Name="btSearch"
                        Clicked="btSearch_Clicked"
                        Grid.Column="1"
                        ImageSource="pesquisa_alt.png"
                        CornerRadius="15"
                        BackgroundColor="{StaticResource MainColor}"/>
            </Grid>
            <!--Lista de resultados-->
            <HorizontalStackLayout HorizontalOptions="Center" 
                                   x:Name="lbNaoEncontrou"
                                   IsVisible="False"
                                   VerticalOptions="Center" 
                                   Spacing="5" 
                                   Grid.Row="1">

                <Label Text="Não encontrou o livro?"
                       FontFamily="Karla"
                       FontSize="14"
                       TextColor="{StaticResource SubFontColor}"
                       VerticalOptions="Center"/>

                <Button x:Name="btNaoEncontrou"
                        Text="Cadastre manualmente"
                        Clicked="btCadastrarManualmente_Clicked"
                        FontFamily="Karla"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="{StaticResource MainColor}"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Padding="0"
                        VerticalOptions="Center"/>

            </HorizontalStackLayout>

            <CollectionView x:Name="BookList"
                Grid.Row="2"
                Margin="16, 0, 16, 90">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                           ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <!-- Card de cada livro -->
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="{StaticResource MainColor}"
                                BackgroundColor="{StaticResource MainColorAlpha}"
                                Padding="10">

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">

                                <!-- Coluna 1: Capa -->
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        HeightRequest="110"
                                        WidthRequest="75"
                                        BackgroundColor="{StaticResource BackgroundColor}">
                                    <Image Aspect="AspectFill"
                                           Source="{Binding CapaUrl, Converter={StaticResource UrlToImageConverter}}" />
                                </Border>

                                <!-- Coluna 2: Informações -->
                                <VerticalStackLayout Grid.Column="1" 
                                                     VerticalOptions="Center" 
                                                     Spacing="4">

                                    <!-- Título -->
                                    <Label Text="{Binding Titulo}"
                                           FontFamily="Fraunces"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource FontColor}"
                                           FontSize="16"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"/>

                                    <!-- Autor -->
                                    <Label Text="{Binding Autor}"
                                           TextColor="{StaticResource SubFontColor}"
                                           FontSize="13"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"/>

                                    <!-- Editora e Ano -->
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Editora}"
                                               TextColor="{StaticResource SubFontAlpha}"
                                               FontSize="11"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"/>

                                        <Label Text="•" 
                                               TextColor="{StaticResource SubFontAlpha}" 
                                               FontSize="11"/>

                                        <Label Text="{Binding Ano}"
                                               TextColor="{StaticResource SubFontAlpha}"
                                               FontSize="11"/>
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                                <!-- GestureRecognizer no card inteiro -->
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLivroTocado"/>
                                </Grid.GestureRecognizers>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <!-- Empty State -->
            <VerticalStackLayout Grid.Row="2" 
                                 x:Name="emptyState"
                                 IsVisible="True"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Padding="40"
                                 Spacing="15">
                <Image Source="pesquisa_content.png"
                       HeightRequest="95"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <Label Text="hmm, ainda estamos trabalhando nisso..."
                       TextColor="{StaticResource FontColor}"
                       FontFamily="Fraunces"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <Label HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="que tal adicionar o seu "
                                  TextColor="{StaticResource SubFontAlpha}"
                                  FontSize="15"
                                  FontFamily="Karla"/>
                            <Span Text="primeiro livro "
                                  TextColor="{StaticResource SubFontAlpha}"
                                  FontSize="15"
                                  FontFamily="Karla"
                                  FontAttributes="Bold"/>
                            <Span Text="manualmente? :)"
                                  TextColor="{StaticResource SubFontAlpha}"
                                  FontSize="15"
                                  FontFamily="Karla"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Button x:Name="btCadastrarManualmente"
                        Clicked="btCadastrarManualmente_Clicked"
                        ImageSource="pencil_icon.png"
                        Text="cadastre manualmente"
                        TextColor="{StaticResource BackgroundColor}"
                        BackgroundColor="{StaticResource MainColor}"
                        CornerRadius="15"
                        FontFamily="Karla"
                        FontSize="15"
                        FontAttributes="Bold"
                        ContentLayout="Left, 10"
                        Margin="0, 10, 0 ,10"/>
            </VerticalStackLayout>
        </Grid>
        
        
        <!--Indicador de Carregamento-->
        
        <!-- Overlay que cobre a tela inteira -->
        <Grid IsVisible="{Binding IsLoading}"
              BackgroundColor="#80000000"
              Grid.RowSpan="99">

            <!-- Card central com o indicador -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="Transparent"
                    BackgroundColor="#80000000"
                    Padding="30,25"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="150"
                    HeightRequest="150">

                <Border.Shadow>
                    <Shadow Brush="Black"
                            Offset="0,4"
                            Radius="12"
                            Opacity="0.3" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <!-- Indicador circular -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       Color="{StaticResource BackgroundColor}"
                                       WidthRequest="50"
                                       HeightRequest="50"
                                       HorizontalOptions="Center" />

                    <!-- Texto abaixo -->
                    <Label Text="Carregando..."
                           FontSize="14"
                           FontFamily="Fraunces"
                           TextColor="{StaticResource BackgroundColor}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>