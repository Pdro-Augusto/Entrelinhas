<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Entrelinhas.Views.PesquisaPage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <!--Grid da página inteira para  indicador de carregamento-->
    <Grid>

        <!-- Barra de pesquisa -->
        <Grid RowDefinitions="Auto, Auto, *" RowSpacing="15">
            <Grid Grid.Row="0"
                  Padding="20, 20, 20, 10"
                  ColumnDefinitions="*, Auto"
                  ColumnSpacing="10">
                <Border StrokeShape="RoundRectangle 10"
                        Stroke="{StaticResource MainColor}"
                        Background="{StaticResource MainColorAlpha}"
                        Padding="10,0"
                        HeightRequest="45">
                    <Grid ColumnDefinitions="Auto, *">
                        <Entry Grid.Column="1"
                                 x:Name="searchBook"
                                 Placeholder="Procure por ISBN, Título, Autor..."
                                 PlaceholderColor="{StaticResource SubFontAlpha}"
                                 BackgroundColor="Transparent"
                                 TextColor="{StaticResource FontColor}"/>
                    </Grid>
                </Border>

                <Button x:Name="btSearch"
                        Clicked="btSearch_Clicked"
                        Grid.Column="1"
                        ImageSource="pesquisa_alt.png"
                        CornerRadius="15"
                        BackgroundColor="{StaticResource MainColor}"/>
            </Grid>

            <VerticalStackLayout Grid.Row="2" 
                                 x:Name="emptyState"
                                 IsVisible="True"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Padding="40"
                                 Spacing="15">
                <Image Source="pesquisa_content.png"
                       HeightRequest="95"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <Label Text="hmm, ainda estamos trabalhando nisso..."
                       TextColor="{StaticResource FontColor}"
                       FontFamily="Fraunces"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <Label HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="que tal adicionar o seu "
                                  TextColor="{StaticResource SubFontAlpha}"
                                  FontSize="15"
                                  FontFamily="Karla"/>
                            <Span Text="primeiro livro "
                                  TextColor="{StaticResource SubFontAlpha}"
                                  FontSize="15"
                                  FontFamily="Karla"
                                  FontAttributes="Bold"/>
                            <Span Text="manualmente? :)"
                                  TextColor="{StaticResource SubFontAlpha}"
                                  FontSize="15"
                                  FontFamily="Karla"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Button x:Name="btSearchByScanner"
                        ImageSource="pencil_icon.png"
                        Text="cadastre manualmente"
                        TextColor="{StaticResource BackgroundColor}"
                        BackgroundColor="{StaticResource MainColor}"
                        CornerRadius="15"
                        FontFamily="Karla"
                        FontSize="15"
                        FontAttributes="Bold"
                        ContentLayout="Left, 10"
                        Margin="0, 10, 0 ,10"/>
            </VerticalStackLayout>

            <!--Testeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-->
            <CollectionView x:Name="BookList"
                            Grid.Row="2"
                    Margin="16, 0, 16, 90">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                             Span="3"
                             HorizontalItemSpacing="12"
                             VerticalItemSpacing="14">
                    </GridItemsLayout>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <Border Stroke="{StaticResource FontColor}"
                            StrokeShape="RoundRectangle 8"
                            HeightRequest="150"
                            WidthRequest="105"
                            BackgroundColor="{StaticResource MainColorAlpha}">

                                <Image Aspect="AspectFill"
                               HeightRequest="150"
                               WidthRequest="105"
                               Source="{Binding CapaUrl}" />

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLivroTocado"/>
                                </Border.GestureRecognizers>
                            </Border>

                            <Label Text="{Binding Titulo}"
                           FontFamily="Fraunces"
                           FontAttributes="Bold"
                           TextColor="{StaticResource FontColor}"
                           FontSize="11"
                           Margin="2, 6, 2, 0"
                           LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </Grid>
        
        
        <!--Indicador de Carregamento-->
        
        <!-- Overlay que cobre a tela inteira -->
        <Grid IsVisible="{Binding IsLoading}"
              BackgroundColor="#80000000"
              Grid.RowSpan="99">

            <!-- Card central com o indicador -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="Transparent"
                    BackgroundColor="#80000000"
                    Padding="30,25"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="150"
                    HeightRequest="150">

                <Border.Shadow>
                    <Shadow Brush="Black"
                            Offset="0,4"
                            Radius="12"
                            Opacity="0.3" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <!-- Indicador circular -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       Color="{StaticResource BackgroundColor}"
                                       WidthRequest="50"
                                       HeightRequest="50"
                                       HorizontalOptions="Center" />

                    <!-- Texto abaixo -->
                    <Label Text="Carregando..."
                           FontSize="14"
                           FontFamily="Fraunces"
                           TextColor="{StaticResource BackgroundColor}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>