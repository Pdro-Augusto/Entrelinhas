<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Entrelinhas.Views.EstantePage"
             BackgroundColor="{StaticResource BackgroundColor}"
             xmlns:droid="clr-namespace:CommunityToolkit.Maui.PlatformConfiguration.AndroidSpecific;assembly=CommunityToolkit.Maui"
             droid:NavigationBar.Color="{StaticResource BackgroundColor}"
             droid:NavigationBar.Style="DarkContent">

    <Grid RowDefinitions="Auto, Auto, *">
        
                   <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20, 24, 20, 8">
            <HorizontalStackLayout>
                <Label Text=".entrelinhas"
                       FontFamily="Fraunces"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource FontColor}"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

                   <!-- Filtros -->
        <HorizontalStackLayout Grid.Row="1"
                               Margin="16, 4, 16, 12"
                               Spacing="8"
                               HorizontalOptions="Fill">
            <Button x:Name="btAllBooks"
                    Text="Todos"
                    TextColor="{StaticResource FontColor}"
                    Clicked="btAllBooks_Clicked"
                    FontFamily="Karla"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="15"
                    HeightRequest="25"
                    Padding="16, 5"
                    HorizontalOptions="Fill"
                    BorderWidth="1"
                    BorderColor="{StaticResource MainColor}"
                    BackgroundColor="{StaticResource MainColorAlpha}">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1"/>
                                </VisualState.Setters>
                            </VisualState>

                            
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver"/>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>

            </Button>

            <Button x:Name="btReading"
                    Text="Lendo"
                    TextColor="{StaticResource FontColor}"
                    Clicked="btReading_Clicked"
                    FontFamily="Karla"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="15"
                    HeightRequest="25"
                    Padding="16, 5"
                    BorderWidth="1"
                    BorderColor="{StaticResource MainColor}"
                    BackgroundColor="{StaticResource MainColorAlpha}">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1"/>
                                </VisualState.Setters>
                            </VisualState>

                            
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver"/>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <Button x:Name="btRead"
                    Text="Lidos"
                    TextColor="{StaticResource FontColor}"
                    Clicked="btRead_Clicked"
                    FontFamily="Karla"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="15"
                    HeightRequest="25"
                    Padding="16, 5"
                    BorderWidth="1"
                    BorderColor="{StaticResource MainColor}"
                    BackgroundColor="{StaticResource MainColorAlpha}">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1"/>
                                </VisualState.Setters>
                            </VisualState>

                            
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.9"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver"/>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
        </HorizontalStackLayout>
        
                   <!-- Conteúdo -->
        <Grid Grid.Row="2">
            <!-- Dá load nos livros -->
            
            <CollectionView x:Name="BookList"
                            Margin="16, 0, 16, 90">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="3"
                                     HorizontalItemSpacing="12"
                                     VerticalItemSpacing="14">
                    </GridItemsLayout>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <Border Stroke="{StaticResource FontColor}"
                                    StrokeShape="RoundRectangle 8"
                                    HeightRequest="150"
                                    WidthRequest="105"
                                    BackgroundColor="{StaticResource MainColorAlpha}">

                                <Image Aspect="AspectFill"
                                       HeightRequest="150"
                                       WidthRequest="105"
                                       Source="{Binding CapaUrl, Converter={StaticResource UrlToImageConverter}}" />

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLivroTocado"/>
                                </Border.GestureRecognizers>
                            </Border>

                            <Label Text="{Binding Titulo}"
                                   FontFamily="Fraunces"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource FontColor}"
                                   FontSize="11"
                                   Margin="2, 6, 2, 0"
                                   LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
            </CollectionView>
            
            <!-- Empty State -->
            <VerticalStackLayout x:Name="EmptyState"
                     IsVisible="True"
                     VerticalOptions="Center"
                     HorizontalOptions="Center"
                     Padding="40"
                     Spacing="10">

                <Image Source="book_icon.png"
           HeightRequest="120"/>

                <Label Text="sua estante está vazia :("
           FontFamily="Fraunces"
           FontAttributes="Bold"
           FontSize="18"
           TextColor="{StaticResource FontColor}"
           HorizontalTextAlignment="Center"/>

                <Label Text="que tal começar com aquele livro que está na sua mesinha há semanas?"
           FontFamily="Karla"
           FontSize="13"
           TextColor="{StaticResource SubFontAlpha}"
           HorizontalTextAlignment="Center"/>
                <Button x:Name="btAddNewBook"
            Text="+ adicione seu primeiro livro"
            Clicked="btAddNewBook_Clicked"
            BackgroundColor="{StaticResource MainColor}"
            TextColor="{StaticResource BackgroundColor}"
            FontFamily="Karla"
            FontSize="15"
            FontAttributes="Bold"
            CornerRadius="15"
            Margin="0, 10, 0, 0"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>