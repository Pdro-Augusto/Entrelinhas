<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Entrelinhas.Models"
             x:Class="Entrelinhas.Views.BookPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto, Auto, Auto, *">
        <Grid Grid.Row="0"
              Padding="20, 16, 20, 0"
              ColumnDefinitions="Auto, *, Auto">
            <Label Grid.Column="0"
                   Text=""
                   FontSize="24"
                   TextColor="{StaticResource FontColor}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVoltarClicado"/>
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="2"
                   FontSize="20"
                   TextColor="{StaticResource FontColor}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuClicado"/>
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <VerticalStackLayout Grid.Row="1"
                             Padding="24, 14, 24, 14"
                             Spacing="3">
            <Label x:Name="lbTitulo"
                   FontFamily="Fraunces"
                   FontAttributes="Bold"
                   FontSize="24"
                   TextColor="{StaticResource FontColor}"/>
            <Label x:Name="lbAutorAno"
                   FontFamily="Karla"
                   FontSize="12"
                   TextColor="{StaticResource SubFontAlpha}"/>
        </VerticalStackLayout>

        <Grid Grid.Row="2"
              Padding="24, 0">
            <BoxView HeightRequest="0.5"
                     VerticalOptions="End"
                     Color="{StaticResource SubFontAlpha}"/>
            <HorizontalStackLayout Spacing="24">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="lbTabProgresso"
                           Text="Progresso"
                           FontFamily="Karla"
                           FontSize="14"/>
                    <BoxView x:Name="ulProgresso"
                             HeightRequest="2"/>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAbaProgressoClicado"/>
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label x:Name="lbTabAnotacoes"
                           Text="Anotações"
                           FontFamily="Karla"
                           FontSize="14"/>
                    <BoxView x:Name="ulAnotacoes"
                             HeightRequest="2"/>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAbaAnotacoesClicado"/>
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label x:Name="lbTabSobre"
                           Text="Sobre"
                           FontFamily="Karla"
                           FontSize="14"/>
                    <BoxView x:Name="ulSobre"
                             HeightRequest="2"/>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAbaSobreClicado"/>
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="3">
            <Grid Padding="24,20,24,30">

                <!-- Progresso -->
                <VerticalStackLayout x:Name="vsProgresso" Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8"
                                WidthRequest="70" HeightRequest="100"
                                BackgroundColor="{StaticResource MainColorAlpha}">
                            <Image x:Name="imgCapa" Aspect="AspectFill" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="8"
                                             VerticalOptions="Center">
                            <Label x:Name="lbProgresso"
                                   FontFamily="Karla" FontSize="13"
                                   TextColor="{StaticResource SubFontColor}" />
                            <ProgressBar x:Name="pbProgresso"
                                         ProgressColor="{StaticResource MainColor}" />
                            <Border x:Name="tagStatus" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource MainColor}"
                                    Padding="12,4" HorizontalOptions="Start">
                                <Label x:Name="lbStatus"
                                       FontFamily="Karla" FontAttributes="Bold"
                                       FontSize="11" TextColor="White" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStatusTocado" />
                                </Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource MainColor}"
                                BackgroundColor="{StaticResource MainColorAlpha}"
                                Padding="14,0" HeightRequest="44">
                            <Entry x:Name="entryPaginasLidas"
                                   Placeholder="Página em que você parou"
                                   PlaceholderColor="{StaticResource SubFontAlpha}"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   FontFamily="Karla"
                                   TextColor="{StaticResource FontColor}" />
                        </Border>
                        <Button Grid.Column="1" Text="atualizar"
                                Clicked="OnAtualizarProgressoClicado"
                                BackgroundColor="{StaticResource MainColor}" TextColor="White"
                                FontFamily="Karla" FontAttributes="Bold"
                                CornerRadius="12" HeightRequest="44" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Anotações -->
                <VerticalStackLayout x:Name="vsAnotacoes" Spacing="14" IsVisible="False">

                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource MainColor}"
                            BackgroundColor="{StaticResource MainColorAlpha}"
                            Padding="14,8">
                        <VerticalStackLayout Spacing="6">
                            <Editor x:Name="edtAnotacao"
                                    Placeholder="Escreva uma anotação ou cole uma citação..."
                                    PlaceholderColor="{StaticResource SubFontAlpha}"
                                    HeightRequest="80" AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    FontFamily="Karla"
                                    TextColor="{StaticResource FontColor}" />
                            <Grid ColumnDefinitions="80,*" ColumnSpacing="10">
                                <Entry x:Name="entryPaginaNota"
                                       Grid.Column="0" Placeholder="pág."
                                       PlaceholderColor="{StaticResource SubFontAlpha}"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       FontFamily="Karla"
                                       TextColor="{StaticResource FontColor}" />
                                <Button Grid.Column="1" Text="salvar anotação"
                                        Clicked="OnSalvarAnotacaoClicado"
                                        BackgroundColor="{StaticResource MainColor}" TextColor="White"
                                        FontFamily="Karla" FontAttributes="Bold"
                                        CornerRadius="10" HeightRequest="40" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="anotações recentes"
                           FontFamily="Karla" FontAttributes="Bold" FontSize="13"
                           TextColor="{StaticResource FontColor}" />

                    <Label x:Name="lbSemAnotacoes"
                           Text="nenhuma anotação ainda :("
                           FontFamily="Karla" FontSize="13"
                           TextColor="{StaticResource SubFontAlpha}" />

                    <VerticalStackLayout x:Name="listaAnotacoes" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Anotacao">
                                <Border StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource MainColorAlpha}"
                                        StrokeThickness="0" Padding="12,10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Texto}"
                                               FontFamily="Karla" FontSize="13" LineHeight="1.35"
                                               TextColor="{StaticResource FontColor}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding Rodape}"
                                                   FontFamily="Karla" FontSize="11"
                                                   TextColor="{StaticResource SubFontAlpha}" />
                                            <Label Grid.Column="1" Text="excluir"
                                                   FontFamily="Karla" FontAttributes="Bold" FontSize="11"
                                                   TextColor="{StaticResource MainColor}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnExcluirAnotacaoTocado" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Sobre -->
                <VerticalStackLayout x:Name="vsSobre" Spacing="16" IsVisible="False">
                    <Label x:Name="lbSinopse"
                           FontFamily="Karla" FontSize="13" LineHeight="1.4"
                           TextColor="{StaticResource SubFontColor}" />

                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="8">
                        <Label Grid.Row="0" Text="editora" FontFamily="Karla" FontSize="12"
                               TextColor="{StaticResource SubFontAlpha}" />
                        <Label Grid.Row="0" Grid.Column="1" x:Name="lbEditora"
                               FontFamily="Karla" FontSize="13"
                               TextColor="{StaticResource FontColor}" />

                        <Label Grid.Row="1" Text="ano" FontFamily="Karla" FontSize="12"
                               TextColor="{StaticResource SubFontAlpha}" />
                        <Label Grid.Row="1" Grid.Column="1" x:Name="lbAno"
                               FontFamily="Karla" FontSize="13"
                               TextColor="{StaticResource FontColor}" />

                        <Label Grid.Row="2" Text="páginas" FontFamily="Karla" FontSize="12"
                               TextColor="{StaticResource SubFontAlpha}" />
                        <Label Grid.Row="2" Grid.Column="1" x:Name="lbPaginas"
                               FontFamily="Karla" FontSize="13"
                               TextColor="{StaticResource FontColor}" />

                        <Label Grid.Row="3" Text="gênero" FontFamily="Karla" FontSize="12"
                               TextColor="{StaticResource SubFontAlpha}" />
                        <Label Grid.Row="3" Grid.Column="1" x:Name="lbGenero"
                               FontFamily="Karla" FontSize="13"
                               TextColor="{StaticResource FontColor}" />

                        <Label Grid.Row="4" Text="ISBN" FontFamily="Karla" FontSize="12"
                               TextColor="{StaticResource SubFontAlpha}" />
                        <Label Grid.Row="4" Grid.Column="1" x:Name="lbIsbn"
                               FontFamily="Karla" FontSize="13"
                               TextColor="{StaticResource FontColor}" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>