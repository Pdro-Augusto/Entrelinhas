<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Entrelinhas.Models"
             x:Class="Entrelinhas.Views.BookPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             xmlns:droid="clr-namespace:CommunityToolkit.Maui.PlatformConfiguration.AndroidSpecific;assembly=CommunityToolkit.Maui"
             droid:NavigationBar.Color="{StaticResource BackgroundColor}"
             droid:NavigationBar.Style="DarkContent"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, Auto, *">

        <Button x:Name="btVolta"
            ImageSource="flecha_esquerda.png"
            Padding="0"
            Clicked="btVolta_Clicked"
            CornerRadius="10"
            WidthRequest="10"
            HeightRequest="10"
            VerticalOptions="Start"
            HorizontalOptions="Start"
            Margin="16, 16, 0, 0"
            BackgroundColor="{StaticResource MainColor}"/>
        
        <Grid Grid.Row="0"
              Padding="20, 16, 20, 0"
              ColumnDefinitions="Auto, *, Auto">

            <ImageButton Grid.Column="2"
                         Source="editar.svg"
                         WidthRequest="40" 
                         HeightRequest="40"
                         Padding="10"
                         CornerRadius="10"
                         BackgroundColor="{StaticResource MainColor}"
                         Clicked="OnEditarClicado"
                         VerticalOptions="Center"
                         HorizontalOptions="End"
                         Margin="0, 0, 16, 0"/>
        </Grid>

        <VerticalStackLayout Grid.Row="1"
                             Padding="24, 14, 24, 14"
                             Spacing="3">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label x:Name="lbTitulo"
                       Text="{Binding Livro.Titulo}"
                       FontFamily="Fraunces"
                       FontAttributes="Bold"
                       FontSize="24"
                       TextColor="{StaticResource FontColor}"/>

                <Label x:Name="lbFavorito" Grid.Column="1"
                       Text="♡" FontSize="28" Padding="8"
                       VerticalOptions="Center"
                       TextColor="{StaticResource SubFontAlpha}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFavoritoTocado"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
            <Label x:Name="lbAutorAno"
                   Text="{Binding Livro.Autor}"
                   FontFamily="Karla"
                   FontSize="12"
                   TextColor="{StaticResource SubFontAlpha}"/>
        </VerticalStackLayout>

        <Grid Grid.Row="2" Padding="12,0">
            <BoxView HeightRequest="0.5" VerticalOptions="End"
             Color="{StaticResource SubFontAlpha}" />
            <HorizontalStackLayout Spacing="0">

                <VerticalStackLayout>
                    <Label x:Name="lbTabProgresso" Text="Progresso"
                   FontFamily="Karla" FontSize="14" FontAttributes="Bold"
                   Padding="12,12,12,8"
                   TextColor="{StaticResource MainColor}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAbaProgressoClicado" />
                        </Label.GestureRecognizers>
                    </Label>
                    <BoxView x:Name="ulProgresso" HeightRequest="2"
                     Color="{StaticResource MainColor}" />
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label x:Name="lbTabAnotacoes" Text="Anotações"
                   FontFamily="Karla" FontSize="14"
                   Padding="12,12,12,8"
                   TextColor="{StaticResource SubFontAlpha}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAbaAnotacoesClicado" />
                        </Label.GestureRecognizers>
                    </Label>
                    <BoxView x:Name="ulAnotacoes" HeightRequest="2" Color="Transparent" />
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label x:Name="lbTabSobre" Text="Sobre"
                   FontFamily="Karla" FontSize="14"
                   Padding="12,12,12,8"
                   TextColor="{StaticResource SubFontAlpha}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAbaSobreClicado" />
                        </Label.GestureRecognizers>
                    </Label>
                    <BoxView x:Name="ulSobre" HeightRequest="2" Color="Transparent" />
                </VerticalStackLayout>

            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="3">
            <Grid Padding="24,20,24,30">

                <!-- Progresso -->
                <VerticalStackLayout x:Name="vsProgresso" Spacing="16">
                    <!--Botão para mover para a estante (quando o livro estiver na lista de desejos)-->
                    <Button x:Name="btMoverEstante"
                            Text="Mover para a estante"
                            Clicked="OnMoverEstanteClicado"
                            IsVisible="False"
                            BackgroundColor="{StaticResource MainColor}"
                            TextColor="White"
                            FontFamily="Karla" FontAttributes="Bold"
                            CornerRadius="12" HeightRequest="44"/>
                    

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8"
                                WidthRequest="70" HeightRequest="100"
                                BackgroundColor="{StaticResource MainColorAlpha}">
                            <Image x:Name="imgCapa" Aspect="AspectFill" Source="{Binding Livro.CapaUrl, Converter={StaticResource UrlToImageConverter}}"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="8"
                                             VerticalOptions="Center">
                            <Label x:Name="lbProgresso"
                                   FontFamily="Karla" FontSize="13"
                                   TextColor="{StaticResource SubFontColor}" />
                            <ProgressBar x:Name="pbProgresso"
                                         ProgressColor="{StaticResource MainColor}"
                                         />
                            <Border x:Name="tagStatus" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource MainColor}"
                                    Padding="12,4" HorizontalOptions="Start">
                                <Label x:Name="lbStatus"
                                       FontFamily="Karla" FontAttributes="Bold"
                                       FontSize="11" TextColor="White" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStatusTocado" />
                                </Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid x:Name="gridAtualizar" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource MainColor}"
                                BackgroundColor="{StaticResource MainColorAlpha}"
                                Padding="14,0" HeightRequest="44">
                            <Entry x:Name="entryPaginasLidas"
                                   Placeholder="Página em que você parou"
                                   PlaceholderColor="{StaticResource SubFontAlpha}"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   FontFamily="Karla"
                                   TextColor="{StaticResource FontColor}" />
                        </Border>
                        <Button Grid.Column="1" Text="Atualizar"
                                Clicked="OnAtualizarProgressoClicado"
                                BackgroundColor="{StaticResource MainColor}" TextColor="White"
                                FontFamily="Karla" FontAttributes="Bold"
                                CornerRadius="12" HeightRequest="44" />
                    </Grid>

                    <!-- Avaliação -->
                    <VerticalStackLayout x:Name="stAvaliacao" Spacing="4">
                        <Label Text="Avaliar livro"
                               FontFamily="Karla" FontAttributes="Bold" FontSize="13"
                               TextColor="{StaticResource FontColor}"/>
                        <HorizontalStackLayout x:Name="stCoracoes" Spacing="0"/>
                        <Label x:Name="lbAvaliacao"
                               FontFamily="Karla" FontSize="12"
                               TextColor="{StaticResource SubFontAlpha}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Anotações -->
                <VerticalStackLayout x:Name="vsAnotacoes" Spacing="14" IsVisible="False">

                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource MainColor}"
                            BackgroundColor="{StaticResource MainColorAlpha}"
                            Padding="14,8">
                        <VerticalStackLayout Spacing="6">
                            <Editor x:Name="edtAnotacao"
                                    Placeholder="Escreva uma anotação ou cole uma citação..."
                                    PlaceholderColor="{StaticResource SubFontAlpha}"
                                    HeightRequest="80" AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    FontFamily="Karla"
                                    TextColor="{StaticResource FontColor}" />
                            <Grid ColumnDefinitions="80,*" ColumnSpacing="10">
                                <Entry x:Name="entryPaginaNota"
                                       Grid.Column="0" Placeholder="pág."
                                       PlaceholderColor="{StaticResource SubFontAlpha}"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       FontFamily="Karla"
                                       TextColor="{StaticResource FontColor}" />
                                <Button Grid.Column="1" Text="Salvar Anotação"
                                        Clicked="OnSalvarAnotacaoClicado"
                                        BackgroundColor="{StaticResource MainColor}" TextColor="White"
                                        FontFamily="Karla" FontAttributes="Bold"
                                        CornerRadius="10" HeightRequest="40" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Anotações Recentes"
                           FontFamily="Karla" FontAttributes="Bold" FontSize="13"
                           TextColor="{StaticResource FontColor}" />

                    <Label x:Name="lbSemAnotacoes"
                           Text="Nenhuma anotação ainda :("
                           FontFamily="Karla" FontSize="13"
                           TextColor="{StaticResource SubFontAlpha}" />

                    <VerticalStackLayout x:Name="listaAnotacoes" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Anotacao">
                                <Border StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource MainColorAlpha}"
                                        StrokeThickness="0" Padding="12,10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Texto}"
                                               FontFamily="Karla" FontSize="13" LineHeight="1.35"
                                               TextColor="{StaticResource FontColor}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding Rodape}"
                                                   FontFamily="Karla" FontSize="11"
                                                   TextColor="{StaticResource SubFontAlpha}" />
                                            <Label Grid.Column="1" Text="excluir"
                                                   FontFamily="Karla" FontAttributes="Bold" FontSize="11"
                                                   TextColor="{StaticResource MainColor}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnExcluirAnotacaoTocado" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Sobre -->
                <VerticalStackLayout x:Name="vsSobre" Spacing="16" IsVisible="False">
                    <Label x:Name="lbSinopse"
                           FontFamily="Karla" FontSize="13" LineHeight="1.4"
                           TextColor="{StaticResource SubFontColor}" />

                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="8">
                        <Label Grid.Row="0" Text="Editora: " FontFamily="Karla" FontSize="12"
                               TextColor="{StaticResource SubFontAlpha}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Livro.Editora, Converter={StaticResource NullToDefault}}"
                               FontFamily="Karla" FontSize="13"
                               TextColor="{StaticResource FontColor}" />

                        <Label Grid.Row="1" Text="Ano de publicação: " FontFamily="Karla" FontSize="12"
                               TextColor="{StaticResource SubFontAlpha}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Livro.Ano, Converter={StaticResource NullToDefault}}"
                               FontFamily="Karla" FontSize="13"
                               TextColor="{StaticResource FontColor}" />

                        <Label Grid.Row="2" Text="Páginas: " FontFamily="Karla" FontSize="12"
                               TextColor="{StaticResource SubFontAlpha}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Livro.Paginas, Converter={StaticResource NullToDefault}}"
                               FontFamily="Karla" FontSize="13"
                               TextColor="{StaticResource FontColor}" />

                        <Label Grid.Row="3" Text="Gênero: " FontFamily="Karla" FontSize="12"
                               TextColor="{StaticResource SubFontAlpha}" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Livro.Genero, Converter={StaticResource NullToDefault}}"
                               FontFamily="Karla" FontSize="13"
                               TextColor="{StaticResource FontColor}" />

                        <Label Grid.Row="4" Text="ISBN: "  FontFamily="Karla" FontSize="12"
                               TextColor="{StaticResource SubFontAlpha}" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding Livro.Isbn, Converter={StaticResource NullToDefault}}"
                               FontFamily="Karla" FontSize="13"
                               TextColor="{StaticResource FontColor}" />
                        
                        <Label Grid.Row="5" Text="Capa: "  FontFamily="Karla" FontSize="12"
                               TextColor="{StaticResource SubFontAlpha}" />
                        <Label Grid.Row="5" Grid.Column="1" Text="{Binding Livro.CapaUrl, Converter={StaticResource NullToDefault}}"
                               FontFamily="Karla" FontSize="13"
                               TextColor="{StaticResource FontColor}" />
                    </Grid>
                    
                    <Button Text="Excluir livro"
                            Clicked="OnExcluirLivroClicado"
                            BackgroundColor="Transparent"
                            TextColor="#B3261E"
                            BorderColor="#B3261E"
                            BorderWidth="1"
                            FontFamily="Karla" FontSize="13"
                            CornerRadius="10" HeightRequest="40"
                            Margin="0, 24, 0, 0"/>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>