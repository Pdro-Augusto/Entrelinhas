<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="Entrelinhas.Views.ScannerPage"
             BackgroundColor="{StaticResource SubFontAlpha}"
             xmlns:droid="clr-namespace:CommunityToolkit.Maui.PlatformConfiguration.AndroidSpecific;assembly=CommunityToolkit.Maui"
             droid:NavigationBar.Color="{StaticResource BackgroundColor}"
             droid:NavigationBar.Style="DarkContent">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{StaticResource SubFontAlpha}" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, *"
      BackgroundColor="{StaticResource SubFontAlpha}">


        <Label x:Name="CodeLabel"
           Grid.Row="0"
           Text="Aponte a câmera para o código de barras do livro"
           TextColor="{StaticResource BackgroundColor}"
           FontSize="16"
           HorizontalOptions="Center"
           VerticalOptions="Center"
           Padding="0,20,0,10" />

        <zxing:CameraBarcodeReaderView
        Grid.Row="1"
        x:Name="cameraBarcodeReaderView"
        BarcodesDetected="BarcodeDetected"
        BackgroundColor="{StaticResource SubFontAlpha}"/>

        <Grid Grid.Row="1" RowDefinitions="*,240,*" ColumnDefinitions="*,240,*">

            <BoxView Grid.Row="0" Grid.ColumnSpan="3" BackgroundColor="#B3000000" />
            <BoxView Grid.Row="2" Grid.ColumnSpan="3" BackgroundColor="#B3000000" />
            <BoxView Grid.Row="1" Grid.Column="0" BackgroundColor="#B3000000" />
            <BoxView Grid.Row="1" Grid.Column="2" BackgroundColor="#B3000000" />

            <Grid Grid.Row="1" Grid.Column="1">
                <BoxView HeightRequest="3" WidthRequest="26" Color="{StaticResource BackgroundColor}" HorizontalOptions="Start" VerticalOptions="Start" CornerRadius="15"/>
                <BoxView HeightRequest="26" WidthRequest="3" Color="{StaticResource BackgroundColor}" HorizontalOptions="Start" VerticalOptions="Start" CornerRadius="15"/>

                <BoxView HeightRequest="3" WidthRequest="26" Color="{StaticResource BackgroundColor}" HorizontalOptions="End" VerticalOptions="Start" CornerRadius="15"/>
                <BoxView HeightRequest="26" WidthRequest="3" Color="{StaticResource BackgroundColor}" HorizontalOptions="End" VerticalOptions="Start" CornerRadius="15"/>

                <BoxView HeightRequest="3" WidthRequest="26" Color="{StaticResource BackgroundColor}" HorizontalOptions="Start" VerticalOptions="End" CornerRadius="15"/>
                <BoxView HeightRequest="26" WidthRequest="3" Color="{StaticResource BackgroundColor}" HorizontalOptions="Start" VerticalOptions="End" CornerRadius="15"/>

                <BoxView HeightRequest="3" WidthRequest="26" Color="{StaticResource BackgroundColor}" HorizontalOptions="End" VerticalOptions="End" CornerRadius="15"/>
                <BoxView HeightRequest="26" WidthRequest="3" Color="{StaticResource BackgroundColor}" HorizontalOptions="End" VerticalOptions="End" CornerRadius="15"/>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>