<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="Entrelinhas.Views.ScannerPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             >

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{StaticResource BackgroundColor}" StatusBarStyle="DarkContent" />
    </ContentPage.Behaviors>
    
    <Grid RowDefinitions="Auto, *"
              
      BackgroundColor="{StaticResource BackgroundColor}">

        <Label x:Name="CodeLabel"
           Grid.Row="0"
           Text="Aponte a câmera para o código de barras do livro"
           TextColor="{StaticResource FontColor}"
           FontSize="16"
           HorizontalOptions="Center"
           VerticalOptions="Center"
           Padding="0,20,0,10" />

        <zxing:CameraBarcodeReaderView
        Grid.Row="1"
        x:Name="cameraBarcodeReaderView"
        BarcodesDetected="BarcodeDetected" />
    </Grid>

</ContentPage>