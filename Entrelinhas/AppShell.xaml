<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Entrelinhas.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Entrelinhas.Views"
    
    Shell.TabBarBackgroundColor="{StaticResource BackgroundColor}"
    Shell.TabBarForegroundColor="{StaticResource MainColor}"
    Shell.TabBarUnselectedColor="#504A1B0C"
    
    Shell.NavBarIsVisible="False">

    <Shell.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{StaticResource BackgroundColor}" StatusBarStyle="DarkContent" />
    </Shell.Behaviors>

    <TabBar>
        <Tab Title="" Route="estante"
             Icon="estante_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:EstantePage}"/>
        </Tab>

        <Tab Title="" Route="pesquisa"
             Icon="pesquisa_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:PesquisaPage}"/>
        </Tab>

        <Tab Title="" Route="scanner"
             Icon="scanner_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:ScannerPage}"/>
        </Tab>

        <Tab Title="" Route="stats"
             Icon="stats_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:StatsPage}"/>
        </Tab>

        <Tab Title="" Route="user"
             Icon="user_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:UserPage}"/>
        </Tab>
    </TabBar>
</Shell>